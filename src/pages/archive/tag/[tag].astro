---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import NavRail from '../../../components/rail/NavRail.astro';
import HomeRightRail from '../../../components/rail/HomeRightRail.astro';
import FeedHeader from '../../../components/home/FeedHeader.astro';
import PostGrid from '../../../components/post-list/PostGrid.astro';
import { getSortedPosts, getTagCounts } from '../../../lib/posts';
import { toPathSegment } from '../../../lib/utils/path';

export const getStaticPaths = (async () => {
  const counts = await getTagCounts();
  return counts.map(({ name }) => ({ params: { tag: toPathSegment(name) }, props: { name } }));
}) satisfies GetStaticPaths;

const { name } = Astro.props as { name: string };
const posts = (await getSortedPosts()).filter((p) => p.tags.includes(name));
---

<Layout variant="list" current="tags" title={`標籤：#${name}`}>
  <NavRail slot="left" currentTags={[name]} />
  <div class="px-4 pb-12 lg:px-10 wide:px-12">
    <nav aria-label="麵包屑" class="flex gap-1.5 pt-6 text-[13px] text-fg-muted lg:pt-8">
      <a href="/archive/tag/" class="hover:text-accent">標籤</a>
      <span aria-hidden="true">›</span>
      <span class="text-fg">#{name}</span>
    </nav>
    <FeedHeader as="h1" title={`標籤：#${name}`} count={posts.length} />
    <PostGrid posts={posts} />
  </div>
  <HomeRightRail slot="right" archiveOnly />
</Layout>

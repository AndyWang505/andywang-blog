---
import Layout from '../../../layouts/Layout.astro';
import NavRail from '../../../components/rail/NavRail.astro';
import HomeRightRail from '../../../components/rail/HomeRightRail.astro';
import FeedHeader from '../../../components/home/FeedHeader.astro';
import Chip from '../../../components/ui/Chip.astro';
import { getTagCounts } from '../../../lib/posts';

const tags = await getTagCounts();
---

<Layout variant="list" current="tags" title="標籤">
  <NavRail slot="left" />
  <div class="px-4 pb-12 lg:px-10 wide:px-12">
    <FeedHeader as="h1" title="標籤" />
    <p class="m-0 mt-4 text-sm text-fg-muted">共 {tags.length} 個標籤</p>
    <div class="mt-5 flex flex-wrap gap-2">
      {tags.map((t) => <Chip href={t.href} label={`#${t.name}`} count={t.count} />)}
    </div>
  </div>
  <HomeRightRail slot="right" />
</Layout>

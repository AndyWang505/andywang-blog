---
import Layout from '../../layouts/Layout.astro';
import NavRail from '../../components/rail/NavRail.astro';
import HomeRightRail from '../../components/rail/HomeRightRail.astro';
import FeedHeader from '../../components/home/FeedHeader.astro';
import ArchiveTimeline from '../../components/post-list/ArchiveTimeline.astro';
import { getSortedPosts, getYearCounts } from '../../lib/posts';

const [posts, years] = await Promise.all([getSortedPosts(), getYearCounts()]);
const byYear = years.map(({ year, count }) => ({
  year,
  count,
  posts: posts.filter((p) => p.dateText.startsWith(`${year}.`)),
}));
---

<Layout variant="list" current="posts" title="所有文章">
  <NavRail slot="left" />
  <div class="px-4 pb-12 lg:px-10 wide:px-12">
    <FeedHeader as="h1" title="所有文章" count={posts.length} />
    <ArchiveTimeline groups={byYear} />
  </div>
  <HomeRightRail slot="right" archiveOnly />
</Layout>

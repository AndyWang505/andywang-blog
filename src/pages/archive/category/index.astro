---
import Layout from '../../../layouts/Layout.astro';
import NavRail from '../../../components/rail/NavRail.astro';
import HomeRightRail from '../../../components/rail/HomeRightRail.astro';
import FeedHeader from '../../../components/home/FeedHeader.astro';
import CategoryGrid from '../../../components/post-list/CategoryGrid.astro';
import { getCategoryCounts } from '../../../lib/posts';

const categories = await getCategoryCounts();
---

<Layout variant="list" current="category" title="分類">
  <NavRail slot="left" />
  <div class="px-4 pb-12 lg:px-10 wide:px-12">
    <FeedHeader as="h1" title="分類" count={categories.length} unit="個" />
    <CategoryGrid />
  </div>
  <HomeRightRail slot="right" />
</Layout>

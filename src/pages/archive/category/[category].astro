---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import NavRail from '../../../components/rail/NavRail.astro';
import HomeRightRail from '../../../components/rail/HomeRightRail.astro';
import FeedHeader from '../../../components/home/FeedHeader.astro';
import PostGrid from '../../../components/post-list/PostGrid.astro';
import { getCategoryCounts, getSortedPosts } from '../../../lib/posts';
import { toPathSegment } from '../../../lib/utils/path';

export const getStaticPaths = (async () => {
  const counts = await getCategoryCounts();
  return counts.map(({ name }) => ({ params: { category: toPathSegment(name) }, props: { name } }));
}) satisfies GetStaticPaths;

const { name } = Astro.props as { name: string };
const posts = (await getSortedPosts()).filter((p) => p.category === name);
---

<Layout variant="list" current="category" title={`分類：${name}`}>
  <NavRail slot="left" currentCategory={name} />
  <div class="px-4 pb-12 lg:px-10 wide:px-12">
    <nav aria-label="麵包屑" class="flex gap-1.5 pt-6 text-sm text-fg-muted lg:pt-8">
      <a href="/archive/category/" class="hover:text-accent">分類</a>
      <span aria-hidden="true">›</span>
      <span class="text-fg">{name}</span>
    </nav>
    <FeedHeader as="h1" title={`分類：${name}`} count={posts.length} />
    <PostGrid posts={posts} />
  </div>
  <HomeRightRail slot="right" archiveOnly />
</Layout>

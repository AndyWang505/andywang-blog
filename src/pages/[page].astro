---
import type { GetStaticPaths, Page } from 'astro';
import Layout from '../layouts/Layout.astro';
import NavRail from '../components/rail/NavRail.astro';
import HomeRightRail from '../components/rail/HomeRightRail.astro';
import FeedHeader from '../components/home/FeedHeader.astro';
import PostGrid from '../components/post-list/PostGrid.astro';
import FeedPager from '../components/post-list/FeedPager.astro';
import { getSortedPosts, type Post } from '../lib/posts';
import { PAGE_SIZE } from '../config/pagination';

export const getStaticPaths = (async ({ paginate }) => {
  return paginate(await getSortedPosts(), { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<Post> };
const prevHref = page.currentPage === 2 ? '/' : page.url.prev;
---

<Layout variant="list" current="home" title={`文章列表 第 ${page.currentPage} 頁`}>
  <NavRail slot="left" />
  <div class="px-4 lg:px-10 wide:px-12">
    <h1 class="sr-only">文章列表 第 {page.currentPage} 頁</h1>
    <FeedHeader title="文章" />
    <PostGrid posts={page.data} />
    <FeedPager prevHref={prevHref} nextHref={page.url.next} page={{ current: page.currentPage, total: page.lastPage }} />
  </div>
  <HomeRightRail slot="right" />
</Layout>

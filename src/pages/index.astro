---
import Layout from '../layouts/Layout.astro';
import NavRail from '../components/rail/NavRail.astro';
import HomeRightRail from '../components/rail/HomeRightRail.astro';
import HomeHero from '../components/home/HomeHero.astro';
import FeedHeader from '../components/home/FeedHeader.astro';
import LeadPost from '../components/home/LeadPost.astro';
import PostGrid from '../components/post-list/PostGrid.astro';
import FeedPager from '../components/post-list/FeedPager.astro';
import { getSeriesOf, getSortedPosts } from '../lib/posts';
import { BANNER_CONFIG } from '../config/banner';
import { SITE_TITLE } from '../config/site';
import { PAGE_SIZE } from '../config/pagination';

const posts = await getSortedPosts();
const [lead, ...rest] = posts;
const series = lead ? await getSeriesOf(lead) : undefined;
---

<Layout variant="home" current="home">
  <NavRail slot="left" mobileAuthor mobileCategories />
  <h1 class="sr-only">{SITE_TITLE}</h1>
  <HomeHero light={BANNER_CONFIG.light} dark={BANNER_CONFIG.dark} />
  <div class="px-4 lg:px-10 wide:px-12">
    <FeedHeader title="最新文章" moreHref="/archive/" moreLabel="所有文章 ›" />
    {lead && <LeadPost post={lead} series={series} />}
    <PostGrid posts={rest.slice(0, PAGE_SIZE - 1)} />
    {posts.length > PAGE_SIZE && <FeedPager nextHref="/2/" moreLabel="更多文章" />}
  </div>
  <HomeRightRail slot="right" />
</Layout>

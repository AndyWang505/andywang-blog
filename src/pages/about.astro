---
import FormattedDate from '../components/FormattedDate.astro';
import Layout from '../layouts/Layout.astro';
import NavRail from '../components/rail/NavRail.astro';
import HomeRightRail from '../components/rail/HomeRightRail.astro';

const setupItems = [
  {
    category: '主機設備',
    items: [
      {
        name: 'MacBook Pro (14-inch) - Apple M1 Pro',
        description: '現役工作用電腦，生產力好夥伴',
        src: 'https://img.freepik.com/free-photo/still-life-device-table_23-2150994379.jpg?semt=ais_hybrid&w=740&q=80',
      },
      {
        name: 'GeForce RTX 2060',
        description: '桌機顯卡，平時遊戲用途',
        src: 'https://img.youtube.com/vi/BFPweXoKZEI/hqdefault.jpg',
      },
    ],
  },
  {
    category: '周邊',
    items: [
      {
        name: 'NuPhy Air75 V2 - 月光灰 / 紫藤軸',
        description: '家用 75% 無線鍵盤，辦公、遊戲用途',
        src: 'https://m.media-amazon.com/images/I/61ybbKUahoL._AC_UF350,350_QL80_.jpg',
      },
      {
        name: '主螢幕 - MSI MAG-274QRFW-X32',
        description: '少數CP值高的白色2K螢幕',
        src: 'https://storage-asset.msi.com/global/picture/image/feature/monitor/MAG-274QRFW-X32/feature-main.png',
      },
      {
        name: '副螢幕 - Dell P2719H-4Y',
        description: '適合閱讀長文的直立式螢幕',
        src: 'https://sunfar.blob.core.windows.net/webimage/jpg360/271/271A40YF10.jpg',
      },
      {
        name: 'BenQ ScreenBar Pro',
        description: '顧眼睛超強掛燈無可挑剔',
        src: 'https://image.benq.com/is/image/benqco/screenbar-pro-product?$ResponsivePreset$&fmt=png-alpha',
      },
      {
        name: 'Razer Seiren Mini - Black',
        description: '',
        src: 'https://assets2.razerzone.com/images/pnx.assets/f8f3ac10a074900c7cfe474208c36126/razer-seiren-mini_500x500_200323.png',
      },
      {
        name: 'AirPods Pro 3',
        description: '',
        src: 'https://ucarecdn.com/a59911ee-7455-4bcf-8ee3-9b384bf5aeba/-/format/auto/-/preview/3000x3000/-/quality/lighter/%E5%8E%BB%E8%83%8CAirPods%20Pro%203.png',
      },
      {
        name: 'Logitech G309 - White',
        description: '',
        src: 'https://resource.logitechg.com/c_fill,q_auto,f_auto,dpr_1.0/d_transparent.gif/content/dam/gaming/en/products/G309-Lightspeed-Gaming-Mouse/gallery/g309-lightspeed-wireless-mouse-white-gallery-1.png',
      },
    ],
  },
];
---

<Layout variant="list" current="about" title="關於">
  <NavRail slot="left" />
  <article class="px-4 pb-14 lg:px-12">
    <div class="mx-auto max-w-measure">
      <header class="pt-6 lg:pt-12">
        <h1 class="m-0 text-3xl font-bold leading-tight tracking-tight text-fg">Andy Wang</h1>
        <p class="m-0 mt-2 text-lg text-fg-muted">Software Engineer / Web Developer</p>
        <p class="m-0 mt-5 text-prose leading-relaxed text-fg-body">
          自由軟體愛好者兼拉麵 &
          咖哩資深獵人，也曾在補教業授課及擔任助教，經常在不同領域中來回走跳，覺得累了就休息一會吧
          ☕。
        </p>
        <p class="m-0 mt-5 rounded-lg bg-bg-subtle px-5 py-4 text-base font-medium leading-relaxed text-fg">
          熱衷學習新技術，不將自己限於單一項目，喜歡交流與分享技術，善於解決問題。
        </p>
        <div class="mt-5 flex flex-col gap-1 text-sm text-fg-muted">
          <span>Profile picture：<a href="https://x.com/Ame_929" target="_blank" class="text-accent underline underline-offset-2 hover:opacity-80">Ame_929</a></span>
          <span>Banner：<a href="https://x.com/nathuo101102" class="text-accent underline underline-offset-2 hover:opacity-80">夏生(なつお)@nathuo101102</a></span>
        </div>
        <p class="m-0 mt-3 text-xs text-fg-muted">Updated <FormattedDate date={new Date('April 05 2026')} /></p>
      </header>

      <section class="mt-12 border-t border-line-muted pt-10">
        <h2 class="m-0 mb-6 text-xl font-bold tracking-tight text-fg">My Setup</h2>
        <div class="flex flex-col gap-8">
          {
            setupItems.map((group) => (
              <div>
                <h3 class="m-0 mb-3 text-sm font-semibold text-fg">{group.category}</h3>
                <ul class="m-0 grid list-none grid-cols-2 gap-3 p-0 @2xl:grid-cols-4">
                  {group.items.map((item) => (
                    <li class="flex flex-col overflow-hidden rounded-lg border border-line-muted">
                      <div class="aspect-[4/3] overflow-hidden bg-bg-subtle">
                        <img src={item.src} alt={item.name} loading="lazy" class="h-full w-full object-cover" />
                      </div>
                      <div class="p-2.5">
                        <p class="m-0 text-xs font-semibold leading-snug text-fg">{item.name}</p>
                        {item.description && <p class="m-0 mt-0.5 text-xs leading-snug text-fg-muted">{item.description}</p>}
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section class="mt-12 border-t border-line-muted pt-10">
        <h2 class="m-0 mb-6 text-xl font-bold tracking-tight text-fg">About Blog</h2>
        <div class="flex flex-col gap-4 text-base leading-relaxed text-fg-body">
          <p class="m-0">
            在早期，這個部落格是使用 Jekyll 架設的，中間也嘗試了幾個不同的 theme，可以參考這篇
            <a
              href="https://andywangtw.dev/post/%E8%87%AA%E5%B7%B1%E7%9A%84%E9%83%A8%E8%90%BD%E6%A0%BC%E8%87%AA%E5%B7%B1%E6%9E%B6/"
              class="text-accent underline underline-offset-2 hover:opacity-80"
              target="_blank">文章</a
            > 有簡短的介紹。
          </p>
          <div class="grid gap-4 @2xl:grid-cols-2">
            <p class="m-0 rounded-lg bg-bg-subtle p-4">
              到了 2024 年，決定重寫部落格架構。現在的部落格主要是使用 Astro、React 和 Tailwind
              開發。如果有興趣，可以參考
              <a href="https://www.youtube.com/@devaslife" target="_blank" class="text-accent underline underline-offset-2 hover:opacity-80">@devaslife</a>
              上的示範影片，另外我也在這篇 <a
                href="https://andywangtw.dev/post/%E8%87%AA%E5%B7%B1%E7%9A%84%E9%83%A8%E8%90%BD%E6%A0%BC%E8%87%AA%E5%B7%B1%E6%9E%B6/"
                class="text-accent underline underline-offset-2 hover:opacity-80"
                target="_blank">短文</a
              > 中分享了關於重構部落格的一些心得。
            </p>
            <p class="m-0 rounded-lg bg-bg-subtle p-4">
              2025
              年後半，腦中又開始浮出想要計畫大改版的念頭，一直覺得元素太少太單調有些無聊，現在的版本參考了
              <a href="https://github.com/saicaca/fuwari" target="_blank" class="text-accent underline underline-offset-2 hover:opacity-80">Fuwari</a>
              的設計，再搭配一些自己的風格整合而成。讚嘆 AI Agent 幫我省下不少開發時間 :D
            </p>
          </div>
          <p class="m-0 rounded-lg bg-bg-subtle p-4 text-fg">
            不知道未來會不會又搬家，但可以確定的是，會將這邊慢慢優化成自己喜歡的樣子！
          </p>
        </div>
      </section>
    </div>
  </article>
  <HomeRightRail slot="right" />
</Layout>

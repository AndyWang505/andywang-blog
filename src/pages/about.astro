---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import Layout from '../layouts/Layout.astro';
import NavRail from '../components/rail/NavRail.astro';
import HomeRightRail from '../components/rail/HomeRightRail.astro';
import Icon from '../components/ui/Icon.astro';
import { AUTHOR } from '../config/site';
import { getCategoryCounts, getSortedPosts } from '../lib/posts';
import macbookPro from '../assets/setup/macbook-pro.jpg';
import rtx2060 from '../assets/setup/rtx-2060.jpg';
import nuphyAir75 from '../assets/setup/nuphy-air75.jpg';
import msiMag274 from '../assets/setup/msi-mag274.png';
import dellP2719h from '../assets/setup/dell-p2719h.jpg';
import screenbarPro from '../assets/setup/screenbar-pro.png';
import seirenMini from '../assets/setup/seiren-mini.png';
import airpodsPro3 from '../assets/setup/airpods-pro-3.png';
import g309 from '../assets/setup/g309.png';

interface SetupItem {
  name: string;
  description: string;
  image: ImageMetadata;
  /** Photos fill the thumbnail; product cut-outs sit inside it. */
  fit?: 'cover' | 'contain';
}

const setupItems: { category: string; items: SetupItem[] }[] = [
  {
    category: '主機設備',
    items: [
      { name: 'MacBook Pro (14-inch) - Apple M1 Pro', description: '現役工作用電腦，生產力好夥伴', image: macbookPro, fit: 'cover' },
      { name: 'GeForce RTX 2060', description: '桌機顯卡，平時遊戲用途', image: rtx2060, fit: 'cover' },
    ],
  },
  {
    category: '周邊',
    items: [
      { name: 'NuPhy Air75 V2 - 月光灰 / 紫藤軸', description: '家用 75% 無線鍵盤，辦公、遊戲用途', image: nuphyAir75 },
      { name: '主螢幕 - MSI MAG-274QRFW-X32', description: '少數CP值高的白色2K螢幕', image: msiMag274 },
      { name: '副螢幕 - Dell P2719H-4Y', description: '適合閱讀長文的直立式螢幕', image: dellP2719h },
      { name: 'BenQ ScreenBar Pro', description: '顧眼睛超強掛燈無可挑剔', image: screenbarPro },
      { name: 'Razer Seiren Mini - Black', description: '', image: seirenMini },
      { name: 'AirPods Pro 3', description: '', image: airpodsPro3 },
      { name: 'Logitech G309 - White', description: '', image: g309 },
    ],
  },
];

const [posts, categories] = await Promise.all([getSortedPosts(), getCategoryCounts()]);
const sinceYear = Math.min(...posts.map((p) => p.pubDate.getFullYear()));
const location = AUTHOR.role.split('·').pop()?.trim();
const stats = [
  { label: '文章', value: posts.length, unit: '篇' },
  { label: '分類', value: categories.length, unit: '個' },
  { label: '開始寫作', value: sinceYear, unit: '' },
];
const links = [
  { href: AUTHOR.links.github, label: 'GitHub', icon: 'github', external: true },
  { href: AUTHOR.links.x, label: 'X', icon: 'x', external: true },
  { href: AUTHOR.links.rss, label: 'RSS', icon: 'rss', external: false },
] as const;

const linkClass = 'text-accent underline underline-offset-2 hover:opacity-80';
const blogPostHref =
  'https://andywangtw.dev/post/%E8%87%AA%E5%B7%B1%E7%9A%84%E9%83%A8%E8%90%BD%E6%A0%BC%E8%87%AA%E5%B7%B1%E6%9E%B6/';
---

<Layout variant="list" current="about" title="關於">
  <NavRail slot="left" />
  <article class="px-4 pb-14 lg:px-12">
    <div class="mx-auto max-w-measure">
      <header class="pt-6 lg:pt-12">
        <div class="flex items-center gap-5">
          <img
            src={AUTHOR.avatar}
            alt={`${AUTHOR.name} 頭像`}
            width="88"
            height="88"
            class="h-20 w-20 shrink-0 rounded-full object-cover lg:h-[88px] lg:w-[88px]"
          />
          <div class="min-w-0">
            <h1 class="m-0 text-3xl font-bold leading-tight tracking-tight text-fg">{AUTHOR.name}</h1>
            <p class="m-0 mt-1 text-base text-fg-muted">
              Software Engineer / Web Developer{location && <span> · {location}</span>}
            </p>
          </div>
        </div>
        <ul class="m-0 mt-5 flex list-none flex-wrap gap-2 p-0">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="inline-flex h-9 items-center gap-2 rounded-full bg-bg-muted px-3.5 text-sm text-fg transition-colors duration-fast hover:text-accent"
                  {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  <Icon name={l.icon} size={15} />
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
        <dl class="m-0 mt-6 grid grid-cols-3 border-y border-line-muted">
          {
            stats.map((s, i) => (
              <div class:list={['py-4', i > 0 && 'border-l border-line-muted pl-5']}>
                <dt class="text-xs text-fg-muted">{s.label}</dt>
                <dd class="m-0 mt-1 text-2xl font-semibold tabular-nums tracking-tight text-fg">
                  {s.value}
                  {s.unit && <span class="ml-1 text-sm font-normal text-fg-muted">{s.unit}</span>}
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="m-0 mt-6 text-prose leading-relaxed text-fg-body">
          自由軟體愛好者兼拉麵 &
          咖哩資深獵人，也曾在補教業授課及擔任助教，經常在不同領域中來回走跳，覺得累了就休息一會吧
          ☕。
        </p>
        <p class="m-0 mt-5 rounded-lg bg-bg-subtle px-5 py-4 text-base font-medium leading-relaxed text-fg">
          熱衷學習新技術，不將自己限於單一項目，喜歡交流與分享技術，善於解決問題。
        </p>
      </header>

      <section class="mt-12 border-t border-line-muted pt-10">
        <h2 class="m-0 mb-2 text-xl font-bold tracking-tight text-fg">My Setup</h2>
        {
          setupItems.map((group) => (
            <div class="mt-6">
              <h3 class="m-0 mb-1 text-sm font-semibold text-fg-muted">{group.category}</h3>
              <ul class="m-0 list-none p-0">
                {group.items.map((item) => (
                  <li class="flex items-center gap-4 border-b border-line-muted py-3">
                    <div class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-md border border-line-muted bg-plate">
                      <Image
                        src={item.image}
                        alt=""
                        width={128}
                        height={128}
                        format="webp"
                        class:list={['h-full w-full', item.fit === 'cover' ? 'object-cover' : 'object-contain p-1']}
                      />
                    </div>
                    <div class="min-w-0">
                      <p class="m-0 text-sm font-semibold text-fg">{item.name}</p>
                      {item.description && <p class="m-0 mt-0.5 text-sm text-fg-muted">{item.description}</p>}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      <section class="mt-12 border-t border-line-muted pt-10">
        <h2 class="m-0 mb-6 text-xl font-bold tracking-tight text-fg">About Blog</h2>
        <ol class="history">
          <li class="stop">
            <p class="when">早期</p>
            <p class="what">
              在早期，這個部落格是使用 Jekyll 架設的，中間也嘗試了幾個不同的 theme，可以參考這篇
              <a href={blogPostHref} class={linkClass} target="_blank">文章</a> 有簡短的介紹。
            </p>
          </li>
          <li class="stop">
            <p class="when">2024</p>
            <p class="what">
              到了 2024 年，決定重寫部落格架構。現在的部落格主要是使用 Astro、React 和 Tailwind
              開發。如果有興趣，可以參考
              <a href="https://www.youtube.com/@devaslife" target="_blank" class={linkClass}>@devaslife</a>
              上的示範影片，另外我也在這篇 <a href={blogPostHref} class={linkClass} target="_blank">短文</a> 中分享了關於重構部落格的一些心得。
            </p>
          </li>
          <li class="stop">
            <p class="when">2025</p>
            <p class="what">
              2025
              年後半，腦中又開始浮出想要計畫大改版的念頭，一直覺得元素太少太單調有些無聊，現在的版本參考了
              <a href="https://github.com/saicaca/fuwari" target="_blank" class={linkClass}>Fuwari</a>
              的設計，再搭配一些自己的風格整合而成。讚嘆 AI Agent 幫我省下不少開發時間 :D
            </p>
          </li>
        </ol>
        <p class="m-0 mt-6 rounded-lg bg-bg-subtle p-4 text-base leading-relaxed text-fg">
          不知道未來會不會又搬家，但可以確定的是，會將這邊慢慢優化成自己喜歡的樣子！
        </p>
      </section>

      <footer class="mt-10 flex flex-col gap-1 text-xs text-fg-muted">
        <span>Profile picture：<a href="https://x.com/Ame_929" target="_blank" class={linkClass}>Ame_929</a></span>
        <span>Banner：<a href="https://x.com/nathuo101102" class={linkClass}>夏生(なつお)@nathuo101102</a></span>
        <span>Updated <FormattedDate date={new Date('April 05 2026')} /></span>
      </footer>
    </div>
  </article>
  <HomeRightRail slot="right" />
</Layout>

<style>
  /* Blog history: dots on a vertical line, matching the archive tree. */
  .history {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stop {
    position: relative;
    padding: 0 0 var(--space-7) var(--space-7);
  }
  .stop::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 14px;
    bottom: -6px;
    border-left: 1px solid var(--color-border-default);
  }
  .stop:last-child::before {
    display: none;
  }
  .stop::after {
    content: '';
    position: absolute;
    left: 0;
    top: 5px;
    width: 11px;
    height: 11px;
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-full);
    background: var(--color-bg-default);
  }
  .when {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-fg-default);
  }
  .what {
    margin: var(--space-2) 0 0;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-fg-body);
  }
</style>

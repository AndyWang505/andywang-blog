---
/**
 * App layout: sticky header, flush rails separated by lines, footer.
 * Pages fill the `left`, default (center) and `right` slots.
 */
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import type { NavKey, RailLeft, RailRight } from '../components/layout/nav';
import { SITE_TITLE, SITE_DESCRIPTION } from '../config/site';
import '../styles/tokens/index.css';
import '../styles/global.css';
import '../styles/shell.css';
import '../styles/transition.css';
import '../styles/photoswipe.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** home/list: left rail from 1024px, right rail beside it from 1440px. post: left rail from 1440px, chapter TOC on the right. */
  variant?: 'home' | 'post' | 'list';
  current?: NavKey;
  /** Image to preload (the home hero). */
  preloadImage?: string;
}

const {
  title,
  description,
  image,
  variant = 'list',
  current,
  preloadImage,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const hasLeft = Astro.slots.has('left');
const hasRight = Astro.slots.has('right');
const left: RailLeft = !hasLeft ? 'none' : variant === 'post' ? 'wide' : 'lg';
const right: RailRight = !hasRight ? 'none' : variant === 'post' ? 'toc' : 'rail';
---

<html lang="zh-Hant">
  <head>
    <script is:inline>
      (function () {
        var param = new URLSearchParams(location.search).get('theme');
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var theme =
          param === 'dark' || param === 'light'
            ? param
            : stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.classList.toggle('dark', theme === 'dark');
        window.__theme = theme;
      })();
    </script>
    <BaseHead title={pageTitle} description={description ?? SITE_DESCRIPTION} image={image} preloadImage={preloadImage} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要內容</a>
    <div id="swup-header" class="sticky top-0 z-header">
      <SiteHeader left={left} right={right} current={current} progress={variant === 'post'} />
      <MobileMenu current={current} />
    </div>
    <div id="swup-shell" class="shell" data-left={left} data-right={right}>
      {
        hasLeft && (
          <aside class="shell-left" aria-label="側欄導覽">
            <slot name="left" />
          </aside>
        )
      }
      <main id="main" class="shell-center transition-swup-fade">
        <slot />
      </main>
      {
        hasRight && (
          <aside class="shell-right" aria-label={right === 'toc' ? '章節目錄' : '補充資訊'}>
            <slot name="right" />
          </aside>
        )
      }
    </div>
    <SiteFooter />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

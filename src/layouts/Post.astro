---
/**
 * Article page: left nav rail (from 1440px), article (720px measure) and chapter TOC.
 */
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import NavRail from '../components/rail/NavRail.astro';
import PostHeader from '../components/post/PostHeader.astro';
import PostCover from '../components/post/PostCover.astro';
import PostBody from '../components/post/PostBody.astro';
import PostFooter from '../components/post/PostFooter.astro';
import ChapterToc from '../components/post/ChapterToc.astro';
import { getPrevNext, getRelatedPosts } from '../lib/posts';
import { toPost } from '../lib/posts-core';
import { buildChapters } from '../lib/toc';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const post = toPost(entry);
const { headings } = await entry.render();
const chapters = buildChapters(headings);
const [{ prev, next }, related] = await Promise.all([getPrevNext(entry.slug), getRelatedPosts(entry.slug, 3)]);
---

<Layout variant="post" current="posts" title={post.title} description={post.description} image={post.cover}>
  <NavRail slot="left" variant="compact" currentCategory={post.category} currentTags={post.tags} />
  <article class="px-4 lg:px-12">
    <PostHeader post={post} chapterCount={chapters.length} />
    <PostCover src={post.cover} alt={`${post.title} 封面`} />
    <PostBody><slot /></PostBody>
    <PostFooter prev={prev} next={next} related={related} />
  </article>
  {chapters.length >= 2 && <ChapterToc slot="right" headings={headings} />}
</Layout>

---
/**
 * Home banner: illustration with the site name over a bottom scrim (content layer, no glass).
 * Spec: docs/redesign/03-components.md C1
 */
import { SITE_TITLE } from '../../config/site';

interface Props {
  src: string;
  credit?: { text: string; url?: string };
}

const { src, credit } = Astro.props;
---

<div class="hero">
  <img src={src} alt="部落格主視覺插畫" width="2400" height="900" fetchpriority="high" decoding="async" />
  <div class="scrim" aria-hidden="true"></div>
  <div class="copy">
    <p class="site">{SITE_TITLE}</p>
    <p class="sub">開發經驗與技術筆記</p>
  </div>
  {
    credit && (
      <a class="credit" href={credit.url} target="_blank" rel="noopener">
        Illust. {credit.text}
      </a>
    )
  }
</div>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    height: clamp(200px, 30vw, 280px);
    background: var(--color-bg-subtle);
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .scrim {
    position: absolute;
    inset: 0;
    background: var(--gradient-scrim);
  }
  /* Text and pill sit on the photo, so they stay white in both themes. */
  .copy {
    position: absolute;
    left: var(--space-4);
    right: var(--space-4);
    bottom: var(--space-4);
    color: #fff;
  }
  .site {
    margin: 0;
    font-size: var(--text-display);
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }
  .sub {
    margin: 6px 0 0;
    font-size: var(--text-sm);
    opacity: 0.9;
  }
  .credit {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    padding: 3px 9px;
    border-radius: var(--radius-full);
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    font-size: 11px;
  }
  @media (min-width: 1024px) {
    .hero {
      height: clamp(240px, 18vw, 420px);
    }
    .copy {
      left: var(--space-10);
      bottom: var(--space-8);
    }
  }
  @media (min-width: 1440px) {
    .copy {
      left: var(--space-12);
    }
  }
</style>

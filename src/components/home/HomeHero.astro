---
/**
 * Home banner: illustration with the site name over a bottom scrim (content layer, no glass).
 * One image per theme, drawn as a background so the theme that is hidden (display: none) is never
 * downloaded; a lazy <img> with display: none is still fetched by Chrome.
 */
import { SITE_TITLE } from '../../config/site';

interface BannerImage {
  src: string;
  /** CSS background-position: which part of the image survives the crop. */
  position?: string;
  credit?: { text: string; url?: string };
}

interface Props {
  light: BannerImage;
  dark: BannerImage;
}

const { light, dark } = Astro.props;
const variants = [
  { theme: 'light', ...light },
  { theme: 'dark', ...dark },
];
---

<div class="hero">
  {
    variants.map((v) => (
      <div
        class:list={['art', `only-${v.theme}`]}
        role="img"
        aria-label="部落格主視覺插畫"
        style={`background-image: url(${v.src}); background-position: ${v.position ?? 'center'}`}
      />
    ))
  }
  <div class="scrim" aria-hidden="true"></div>
  <div class="copy">
    <p class="site">{SITE_TITLE}</p>
  </div>
  {
    variants.map(
      (v) =>
        v.credit && (
          <a class:list={['credit', `only-${v.theme}`]} href={v.credit.url} target="_blank" rel="noopener">
            Illust. {v.credit.text}
          </a>
        )
    )
  }
</div>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    height: clamp(200px, 30vw, 280px);
    background: var(--color-bg-subtle);
  }
  .art {
    width: 100%;
    height: 100%;
    background-size: cover;
  }
  .only-light {
    display: var(--display-light-only);
  }
  .only-dark {
    display: var(--display-dark-only);
  }
  .scrim {
    position: absolute;
    inset: 0;
    background: var(--gradient-scrim);
  }
  /* Text and pill sit on the photo, so they stay white in both themes. */
  .copy {
    position: absolute;
    left: var(--space-4);
    right: var(--space-4);
    bottom: var(--space-4);
    color: #fff;
  }
  .site {
    margin: 0;
    font-size: var(--text-display);
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }
  .credit {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    padding: 3px 9px;
    border-radius: var(--radius-full);
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    font-size: 11px;
  }
  @media (min-width: 1024px) {
    .hero {
      height: clamp(240px, 18vw, 420px);
    }
    .copy {
      left: var(--space-10);
      bottom: var(--space-8);
    }
  }
  @media (min-width: 1440px) {
    .copy {
      left: var(--space-12);
    }
  }
</style>

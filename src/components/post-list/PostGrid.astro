---
/**
 * Post list that adapts to the center column width: 1 column, 2 from 1080px, 3 from 1600px,
 * with vertical rules between columns.
 */
import PostRow from './PostRow.astro';
import type { Post } from '../../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="post-grid">
  {
    posts.map((post) => (
      <li class="cell">
        <PostRow post={post} />
      </li>
    ))
  }
</ul>

<style>
  /* Dividers and column gutters belong to the grid cells; PostRow only lays out its own content. */
  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cell {
    min-width: 0;
    border-bottom: 1px solid var(--color-border-muted);
  }
  @container center (1080px <= width < 1600px) {
    .post-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cell:nth-child(odd) {
      padding-right: var(--space-7);
    }
    .cell:nth-child(even) {
      padding-left: var(--space-7);
      border-left: 1px solid var(--color-border-muted);
    }
  }
  @container center (width >= 1600px) {
    .post-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .cell {
      padding-inline: var(--space-7);
      border-left: 1px solid var(--color-border-muted);
    }
    .cell:nth-child(3n + 1) {
      padding-left: 0;
      border-left: 0;
    }
    .cell:nth-child(3n) {
      padding-right: 0;
    }
  }
</style>

---
/**
 * Archive timeline (carried over from v1): year headings, then date · dot on a
 * vertical line · title · tags. The dot grows and turns accent on hover.
 * Year headings carry id="y{year}" for the ArchiveYears rail links.
 */
import type { Post } from '../../lib/posts';

interface Props {
  groups: { year: number; count: number; posts: Post[] }[];
}

const { groups } = Astro.props;
const monthDay = (p: Post) => p.dateText.slice(5);
---

<div class="timeline">
  {
    groups.map((group) => (
      <section aria-labelledby={`y${group.year}`} class="year">
        <h2 id={`y${group.year}`} class="year-head">
          <span class="year-num">{group.year}</span>
          <span class="axis" aria-hidden="true">
            <span class="ring" />
          </span>
          <span class="year-count">{group.count} 篇</span>
        </h2>
        <ol class="m-0 list-none p-0">
          {group.posts.map((post) => (
            <li>
              <a href={post.url} class="entry group">
                <time datetime={post.isoDate} class="date">
                  {monthDay(post)}
                </time>
                <span class="axis" aria-hidden="true">
                  <span class="dot" />
                </span>
                <span class="title">{post.title}</span>
                <span class="tags">{post.tags.slice(0, 2).map((t) => `#${t}`).join(' ')}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .timeline {
    --date-col: 3.5rem;
    --axis-col: 2rem;
    padding-top: var(--space-4);
  }
  .year + .year {
    margin-top: var(--space-6);
  }
  .year-head,
  .entry {
    display: grid;
    grid-template-columns: var(--date-col) var(--axis-col) minmax(0, 1fr);
    align-items: center;
  }
  .year-head {
    height: 3.25rem;
    margin: 0;
    scroll-margin-top: calc(var(--header-height) + var(--space-4));
  }
  .year-num {
    text-align: right;
    font-size: var(--text-xl);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--color-fg-default);
  }
  .year-count {
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-fg-muted);
  }
  .axis {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .entry .axis::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--color-border-default);
    transform: translateX(-50%);
  }
  .ring {
    width: 10px;
    height: 10px;
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-full);
  }
  .entry {
    min-height: 2.5rem;
    border-radius: var(--radius-md);
    transition: background var(--duration-fast);
  }
  .entry:hover {
    background: var(--color-bg-muted);
  }
  .date {
    text-align: right;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--color-fg-muted);
  }
  .dot {
    position: relative;
    width: 4px;
    height: 4px;
    border-radius: var(--radius-full);
    background: var(--color-fg-subtle);
    outline: 2px solid var(--color-bg-default);
    transition:
      height var(--duration-base) var(--ease-standard),
      background var(--duration-base);
  }
  .entry:hover .dot {
    height: 18px;
    background: var(--color-accent);
    outline-color: var(--color-bg-muted);
  }
  .title {
    padding-right: var(--space-4);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-fg-default);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition:
      transform var(--duration-base) var(--ease-standard),
      color var(--duration-fast);
  }
  .entry:hover .title {
    transform: translateX(4px);
    color: var(--color-accent);
  }
  .tags {
    display: none;
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @container center (min-width: 768px) {
    .timeline {
      --date-col: 4.5rem;
      --axis-col: 3rem;
    }
    .entry {
      grid-template-columns: var(--date-col) var(--axis-col) minmax(0, 1fr) minmax(0, 14rem);
    }
    .tags {
      display: block;
    }
  }
</style>

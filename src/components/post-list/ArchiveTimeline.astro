---
/**
 * Archive timeline: one spine per year with a dot per post and the month in a left gutter
 * (shown on the month's first post). Year headings carry id="y{year}" for the rail links,
 * a month's first row id="m{year}-{MM}" for the heatmap. Scroll state (passed dots),
 * reveal and the hover preview card live in scripts/archive.ts.
 */
import { getImage } from 'astro:assets';
import type { Post } from '../../lib/posts';

interface Props {
  groups: { year: number; count: number; posts: Post[] }[];
}

const { groups } = Astro.props;

const years = groups.map((g) => ({
  ...g,
  rows: g.posts.map((post, i) => {
    const month = post.dateText.slice(5, 7);
    const firstOfMonth = i === 0 || g.posts[i - 1].dateText.slice(5, 7) !== month;
    return { post, month, firstOfMonth };
  }),
}));

/** Small cover thumbnails for the hover preview, generated at build time. */
const peekCovers = new Map<string, string>();
await Promise.all(
  groups
    .flatMap((g) => g.posts)
    .filter((p) => p.cover)
    .map(async (p) => {
      const img = await getImage({ src: p.cover!, width: 240, height: 150, format: 'webp', inferSize: false });
      peekCovers.set(p.slug, img.src);
    }),
);
---

<div class="timeline" data-archive>
  {
    years.map((year) => (
      <section class="year" aria-labelledby={`y${year.year}`}>
        <h2 id={`y${year.year}`} class="year-head">
          <span class="year-num">{year.year}</span>
          <span class="count">{year.count} 篇</span>
        </h2>
        <ol class="rows">
          {year.rows.map(({ post, month, firstOfMonth }) => (
            <li
              class:list={['row', firstOfMonth && 'month-start']}
              id={firstOfMonth ? `m${year.year}-${month}` : undefined}
              data-archive-row
            >
              <span class="month">{firstOfMonth && `${Number(month)} 月`}</span>
              <span class="dot" aria-hidden="true" />
              <a
                href={post.url}
                class="entry"
                data-peek-title={post.title}
                data-peek-desc={post.description}
                data-peek-meta={`${post.category} · ${post.dateText} · ${post.readingMinutes} 分鐘`}
                data-peek-cover={peekCovers.get(post.slug)}
              >
                <time datetime={post.isoDate} class="date">
                  {post.dateText.slice(5)}
                </time>
                <span class="title">{post.title}</span>
                {post.tags.length > 0 && <span class="tags">{post.tags.slice(0, 2).map((t) => `#${t}`).join(' ')}</span>}
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<div class="peek" aria-hidden="true" hidden data-archive-peek>
  <div class="peek-body">
    <p class="peek-meta" data-peek-meta-out></p>
    <p class="peek-title" data-peek-title-out></p>
    <p class="peek-desc" data-peek-desc-out></p>
  </div>
  <img class="peek-cover" alt="" width="240" height="150" data-peek-img />
</div>

<style>
  .timeline {
    --month-w: 2.75rem;
    --spine-w: 1.5rem;
    --dot: 9px;
    /* Vertical centre of the title's first line inside a row (entry padding + half a line). */
    --dot-y: 1.25rem;
    padding-top: var(--space-4);
  }
  .year + .year {
    margin-top: var(--space-8);
  }

  .year-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-3) 0;
    scroll-margin-top: var(--header-height);
  }
  /* From 1024px the current year sticks under the header (below that the category bar is sticky). */
  @media (min-width: 1024px) {
    .year-head {
      position: sticky;
      top: var(--header-height);
      z-index: 1;
      background: var(--color-bg-default);
    }
  }
  .year-num {
    font-size: var(--text-xl);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--color-fg-default);
  }
  .count {
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .row {
    --pad: 0px;
    position: relative;
    display: grid;
    grid-template-columns: var(--month-w) var(--spine-w) minmax(0, 1fr);
    padding-top: var(--pad);
    scroll-margin-top: calc(var(--header-height) + 3.5rem);
    transition:
      opacity 0.45s var(--ease-standard),
      translate 0.45s var(--ease-standard);
  }
  .row.month-start:not(:first-child) {
    --pad: var(--space-4);
  }

  /* Spine: one segment per row; segments of passed rows turn accent. */
  .row::before {
    content: '';
    position: absolute;
    left: calc(var(--month-w) + var(--spine-w) / 2);
    top: 0;
    bottom: 0;
    width: 2px;
    margin-left: -1px;
    background: color-mix(in srgb, var(--color-fg-subtle) 40%, transparent);
    transition: background var(--duration-base) var(--ease-standard);
  }
  .row:first-child::before {
    top: calc(var(--pad) + var(--dot-y));
  }
  .row:last-child::before {
    bottom: auto;
    height: calc(var(--pad) + var(--dot-y));
  }
  .row:first-child:last-child::before {
    display: none;
  }
  .row.passed::before {
    background: var(--color-accent);
  }

  .month {
    padding-top: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: var(--leading-snug);
    color: var(--color-fg-default);
  }
  .dot {
    position: relative;
    z-index: 1;
    justify-self: center;
    width: var(--dot);
    height: var(--dot);
    margin-top: calc(var(--dot-y) - var(--dot) / 2);
    border: 2px solid var(--color-fg-subtle);
    border-radius: var(--radius-full);
    background: var(--color-bg-default);
    transition:
      border-color var(--duration-base) var(--ease-standard),
      background var(--duration-base) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }
  .row.passed .dot {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }
  .row:hover .dot {
    transform: scale(1.35);
    border-color: var(--color-accent);
  }

  .entry {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    column-gap: var(--space-3);
    align-items: baseline;
    padding: 0.5rem var(--space-2);
    border-radius: var(--radius-md);
    transition: background var(--duration-fast);
  }
  .entry:hover {
    background: var(--color-bg-muted);
  }
  .date {
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--color-fg-muted);
  }
  .title {
    font-size: var(--text-base);
    font-weight: 500;
    line-height: var(--leading-snug);
    color: var(--color-fg-default);
    transition: color var(--duration-fast);
  }
  .entry:hover .title {
    color: var(--color-accent);
  }
  .tags {
    grid-column: 2;
    margin-top: 2px;
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
  }

  /* Reveal: scripts/archive.ts hides rows below the fold, then shows them as they scroll in. */
  .row.pre-reveal {
    opacity: 0;
    translate: 0 10px;
  }

  /*
   * Hover preview card (pointer devices from 1024px). Placed by scripts/archive.ts beside the
   * list: over the right rail when it is a side column, else over the tags column, so titles
   * and dates on the reading path are never covered.
   */
  .peek {
    position: fixed;
    z-index: var(--z-overlay);
    display: flex;
    gap: var(--space-4);
    width: 340px;
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-4);
    border: 1px solid var(--color-border-muted);
    border-radius: var(--radius-lg);
    background: var(--color-bg-default);
    box-shadow: var(--shadow-popover);
    pointer-events: none;
    opacity: 0;
    translate: 6px 0;
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      translate var(--duration-fast) var(--ease-standard);
  }
  .peek[hidden] {
    display: none;
  }
  .peek.show {
    opacity: 1;
    translate: 0 0;
  }
  .peek-body {
    min-width: 0;
    flex: 1;
  }
  .peek-cover {
    flex-shrink: 0;
    align-self: flex-start;
    width: 104px;
    height: auto;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-md);
    object-fit: cover;
    background: var(--color-bg-subtle);
  }
  .peek-cover[hidden] {
    display: none;
  }
  .peek-meta {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
  }
  .peek-title {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: var(--color-fg-default);
  }
  .peek-desc {
    display: -webkit-box;
    margin: var(--space-1) 0 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
    color: var(--color-fg-body);
  }

  @container center (min-width: 768px) {
    .timeline {
      --month-w: 3.5rem;
      --spine-w: 2rem;
    }
    .entry {
      grid-template-columns: 3.5rem minmax(0, 1fr) minmax(0, 14rem);
    }
    .tags {
      grid-column: 3;
      margin-top: 0;
      font-size: var(--text-sm);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>

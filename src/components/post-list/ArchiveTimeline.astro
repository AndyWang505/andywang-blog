---
/**
 * Archive tree: year → month → posts, joined by connector lines.
 * Evolved from the v1 timeline (date · dot on a line · title · tags).
 * Year nodes carry id="y{year}" for the ArchiveYears rail links.
 */
import type { Post } from '../../lib/posts';

interface Props {
  groups: { year: number; count: number; posts: Post[] }[];
}

const { groups } = Astro.props;

const tree = groups.map((g) => {
  const months = new Map<string, Post[]>();
  for (const p of g.posts) {
    const month = p.dateText.slice(5, 7);
    months.set(month, [...(months.get(month) ?? []), p]);
  }
  return { ...g, months: [...months].map(([month, posts]) => ({ month: Number(month), posts })) };
});
---

<ol class="tree">
  {
    tree.map((year) => (
      <li class="year">
        <h2 id={`y${year.year}`} class="node year-node">
          <span class="ring" aria-hidden="true" />
          <span class="year-num">{year.year}</span>
          <span class="count">{year.count} 篇</span>
        </h2>
        <ol class="branch">
          {year.months.map((m) => (
            <li>
              <p class="node month-node">
                {m.month} 月<span class="count">{m.posts.length} 篇</span>
              </p>
              <ol class="branch">
                {m.posts.map((post) => (
                  <li class="leaf">
                    <a href={post.url} class="entry">
                      <time datetime={post.isoDate} class="date">
                        {post.dateText.slice(5)}
                      </time>
                      <span class="title">{post.title}</span>
                      {post.tags.length > 0 && <span class="tags">{post.tags.slice(0, 2).map((t) => `#${t}`).join(' ')}</span>}
                    </a>
                  </li>
                ))}
              </ol>
            </li>
          ))}
        </ol>
      </li>
    ))
  }
</ol>

<style>
  .tree,
  .branch {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tree {
    --row: 2.5rem;
    --indent: 1.5rem;
    --connector: var(--color-border-default);
    padding-top: var(--space-6);
  }
  .year + .year {
    margin-top: var(--space-8);
  }

  .node {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--row);
    margin: 0;
  }
  .year-node {
    scroll-margin-top: calc(var(--header-height) + var(--space-4));
  }
  .ring {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-full);
    background: var(--color-bg-default);
  }
  .year-num {
    font-size: var(--text-xl);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--color-fg-default);
  }
  .month-node {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-fg-default);
  }
  .count {
    margin-left: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-fg-muted);
  }

  /* Tree connectors: a vertical trunk per branch, an elbow into every child */
  .branch {
    margin-left: 5px; /* centre of the year ring */
  }
  .branch .branch {
    margin-left: 0;
  }
  .branch > li {
    position: relative;
    padding-left: var(--indent);
  }
  .branch > li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    border-left: 1px solid var(--connector);
  }
  .branch > li:last-child::before {
    bottom: auto;
    height: calc(var(--row) / 2);
  }
  .branch > li::after {
    content: '';
    position: absolute;
    left: 0;
    top: calc(var(--row) / 2);
    width: calc(var(--indent) - 6px);
    border-top: 1px solid var(--connector);
  }

  .entry {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    column-gap: var(--space-3);
    align-items: baseline;
    padding: 9px var(--space-2);
    margin-left: -8px;
    border-radius: var(--radius-md);
    transition: background var(--duration-fast);
  }
  .entry:hover {
    background: var(--color-bg-muted);
  }
  .leaf:hover::after {
    border-top-color: var(--color-accent);
  }
  .date {
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--color-fg-muted);
  }
  .title {
    font-size: var(--text-base);
    font-weight: 500;
    line-height: var(--leading-snug);
    color: var(--color-fg-default);
    transition: color var(--duration-fast);
  }
  .entry:hover .title {
    color: var(--color-accent);
  }
  .tags {
    grid-column: 2;
    margin-top: 2px;
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
  }

  @container center (min-width: 768px) {
    .tree {
      --indent: 2rem;
    }
    .entry {
      grid-template-columns: 3.5rem minmax(0, 1fr) minmax(0, 14rem);
    }
    .tags {
      grid-column: 3;
      margin-top: 0;
      font-size: var(--text-sm);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>

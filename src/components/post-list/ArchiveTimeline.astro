---
/**
 * Archive tree: year → month → posts, joined by connector lines.
 * Evolved from the v1 timeline (date · dot on a line · title · tags).
 * Year nodes carry id="y{year}" for the ArchiveYears rail links, month nodes id="m{year}-{MM}"
 * for the heatmap. Scroll progress, reveal and hover preview live in scripts/archive.ts.
 */
import { getImage } from 'astro:assets';
import type { Post } from '../../lib/posts';

interface Props {
  groups: { year: number; count: number; posts: Post[] }[];
}

const { groups } = Astro.props;

const tree = groups.map((g) => {
  const months = new Map<string, Post[]>();
  for (const p of g.posts) {
    const month = p.dateText.slice(5, 7);
    months.set(month, [...(months.get(month) ?? []), p]);
  }
  return { ...g, months: [...months].map(([month, posts]) => ({ month: Number(month), key: month, posts })) };
});

/** Small cover thumbnails for the hover preview, generated at build time. */
const peekCovers = new Map<string, string>();
await Promise.all(
  groups
    .flatMap((g) => g.posts)
    .filter((p) => p.cover)
    .map(async (p) => {
      const img = await getImage({ src: p.cover!, width: 320, height: 200, format: 'webp', inferSize: false });
      peekCovers.set(p.slug, img.src);
    }),
);
---

<ol class="tree" data-archive>
  <span class="fill" aria-hidden="true" data-archive-fill></span>
  {
    tree.map((year) => (
      <li class="year">
        <h2 id={`y${year.year}`} class="node year-node">
          <span class="ring" aria-hidden="true" />
          <span class="year-num">{year.year}</span>
          <span class="count">{year.count} 篇</span>
        </h2>
        <ol class="branch">
          {year.months.map((m) => (
            <li>
              <p id={`m${year.year}-${m.key}`} class="node month-node">
                {m.month} 月<span class="count">{m.posts.length} 篇</span>
              </p>
              <ol class="branch">
                {m.posts.map((post) => (
                  <li class="leaf">
                    <a
                      href={post.url}
                      class="entry"
                      data-peek-title={post.title}
                      data-peek-desc={post.description}
                      data-peek-meta={`${post.category} · ${post.dateText} · ${post.readingMinutes} 分鐘`}
                      data-peek-cover={peekCovers.get(post.slug)}
                    >
                      <time datetime={post.isoDate} class="date">
                        {post.dateText.slice(5)}
                      </time>
                      <span class="title">{post.title}</span>
                      {post.tags.length > 0 && <span class="tags">{post.tags.slice(0, 2).map((t) => `#${t}`).join(' ')}</span>}
                    </a>
                  </li>
                ))}
              </ol>
            </li>
          ))}
        </ol>
      </li>
    ))
  }
</ol>

<div class="peek" aria-hidden="true" hidden data-archive-peek>
  <img class="peek-cover" alt="" width="320" height="200" data-peek-img />
  <div class="peek-body">
    <p class="peek-meta" data-peek-meta-out></p>
    <p class="peek-title" data-peek-title-out></p>
    <p class="peek-desc" data-peek-desc-out></p>
  </div>
</div>

<style>
  .tree,
  .branch {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tree {
    --row: 2.5rem;
    --indent: 1.5rem;
    --connector: var(--color-border-default);
    position: relative;
    padding-top: var(--space-6);
  }
  /* Scroll progress: an accent line over the trunk, grown by scripts/archive.ts via --fill. */
  .fill {
    position: absolute;
    left: 5px;
    top: calc(var(--space-6) + var(--row) / 2);
    bottom: 0;
    width: 2px;
    margin-left: -0.5px;
    background: var(--color-accent);
    transform: scaleY(var(--fill, 0));
    transform-origin: top;
    pointer-events: none;
  }
  .year + .year {
    margin-top: var(--space-8);
  }

  .node {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--row);
    margin: 0;
  }
  .year-node {
    position: relative;
    z-index: 1;
    scroll-margin-top: calc(var(--header-height) + var(--space-4));
  }
  .month-node {
    scroll-margin-top: calc(var(--header-height) + var(--row) + var(--space-4));
  }
  /* From 1024px the current year sticks under the header (below that the category bar is sticky). */
  @media (min-width: 1024px) {
    .year-node {
      position: sticky;
      top: var(--header-height);
      background: var(--color-bg-default);
    }
  }
  .ring {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-full);
    background: var(--color-bg-default);
  }
  .year-num {
    font-size: var(--text-xl);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--color-fg-default);
  }
  .month-node {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-fg-default);
  }
  .count {
    margin-left: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-fg-muted);
  }

  /* Tree connectors: a vertical trunk per branch, an elbow into every child */
  .branch {
    margin-left: 5px; /* centre of the year ring */
  }
  .branch .branch {
    margin-left: 0;
  }
  .branch > li {
    position: relative;
    padding-left: var(--indent);
  }
  .branch > li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    border-left: 1px solid var(--connector);
  }
  .branch > li:last-child::before {
    bottom: auto;
    height: calc(var(--row) / 2);
  }
  .branch > li::after {
    content: '';
    position: absolute;
    left: 0;
    top: calc(var(--row) / 2);
    width: calc(var(--indent) - 6px);
    border-top: 1px solid var(--connector);
  }

  .entry {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    column-gap: var(--space-3);
    align-items: baseline;
    padding: 9px var(--space-2);
    margin-left: -8px;
    border-radius: var(--radius-md);
    transition: background var(--duration-fast);
  }
  .entry:hover {
    background: var(--color-bg-muted);
  }
  .leaf:hover::after {
    border-top-color: var(--color-accent);
  }
  .date {
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--color-fg-muted);
  }
  .title {
    font-size: var(--text-base);
    font-weight: 500;
    line-height: var(--leading-snug);
    color: var(--color-fg-default);
    transition: color var(--duration-fast);
  }
  .entry:hover .title {
    color: var(--color-accent);
  }
  /* Reveal: scripts/archive.ts hides rows below the fold, then shows them as they scroll in. */
  .leaf {
    transition:
      opacity 0.45s var(--ease-standard),
      translate 0.45s var(--ease-standard);
  }
  .leaf.pre-reveal {
    opacity: 0;
    translate: 0 10px;
  }

  /* Hover preview card (pointer devices only; positioned by scripts/archive.ts). */
  .peek {
    position: fixed;
    z-index: var(--z-overlay);
    width: 300px;
    overflow: hidden;
    border: 1px solid var(--color-border-muted);
    border-radius: var(--radius-lg);
    background: var(--color-bg-default);
    box-shadow: var(--shadow-popover);
    pointer-events: none;
    opacity: 0;
    translate: 0 4px;
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      translate var(--duration-fast) var(--ease-standard);
  }
  .peek.show {
    opacity: 1;
    translate: 0 0;
  }
  .peek-cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--color-bg-subtle);
  }
  .peek-cover[hidden] {
    display: none;
  }
  .peek-body {
    padding: var(--space-3) var(--space-4) var(--space-4);
  }
  .peek-meta {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
  }
  .peek-title {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: var(--color-fg-default);
  }
  .peek-desc {
    display: -webkit-box;
    margin: var(--space-1) 0 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
    color: var(--color-fg-body);
  }

  .tags {
    grid-column: 2;
    margin-top: 2px;
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
  }

  @container center (min-width: 768px) {
    .tree {
      --indent: 2rem;
    }
    .entry {
      grid-template-columns: 3.5rem minmax(0, 1fr) minmax(0, 14rem);
    }
    .tags {
      grid-column: 3;
      margin-top: 0;
      font-size: var(--text-sm);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>

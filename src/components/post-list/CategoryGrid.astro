---
/**
 * Category index: one cell per category with its post count, last update and latest titles.
 * Columns follow the center column width like PostGrid: 1, 2 from 1080px, 3 from 1600px.
 */
import { getCategoryCounts, getSortedPosts } from '../../lib/posts';

const LATEST = 3;
const [categories, posts] = await Promise.all([getCategoryCounts(), getSortedPosts()]);
const cells = categories.map((c) => ({
  ...c,
  latest: posts.filter((p) => p.category === c.name).slice(0, LATEST),
}));
---

<ul class="cat-grid">
  {
    cells.map((c) => (
      <li class="cell">
        <a href={c.href} class="group flex items-baseline justify-between gap-3">
          <h2 class="m-0 text-lg font-semibold tracking-tight text-fg transition-colors duration-fast group-hover:text-accent">
            {c.name}
          </h2>
          <span class="shrink-0 text-xs tabular-nums text-fg-muted">{c.count} 篇</span>
        </a>
        {c.latest[0] && <p class="m-0 mt-1 text-xs tabular-nums text-fg-muted">最近更新 {c.latest[0].dateText}</p>}
        <ul class="m-0 mt-3 list-none p-0">
          {c.latest.map((p) => (
            <li>
              <a
                href={p.url}
                class="block truncate py-1 text-sm text-fg-body transition-colors duration-fast hover:text-accent"
              >
                {p.title}
              </a>
            </li>
          ))}
        </ul>
        {
          c.count > LATEST && (
            <a href={c.href} class="mt-2 inline-block text-xs text-accent hover:underline">
              查看全部 {c.count} 篇 ›
            </a>
          )
        }
      </li>
    ))
  }
</ul>

<style>
  .cat-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cell {
    min-width: 0;
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-border-muted);
  }
  @container center (1080px <= width < 1600px) {
    .cat-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cell:nth-child(odd) {
      padding-right: var(--space-7);
    }
    .cell:nth-child(even) {
      padding-left: var(--space-7);
      border-left: 1px solid var(--color-border-muted);
    }
  }
  @container center (width >= 1600px) {
    .cat-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .cell {
      padding-inline: var(--space-7);
      border-left: 1px solid var(--color-border-muted);
    }
    .cell:nth-child(3n + 1) {
      padding-left: 0;
      border-left: 0;
    }
    .cell:nth-child(3n) {
      padding-right: 0;
    }
  }
</style>

---
/**
 * Posts per month as a year × month grid, styled like a GitHub contribution graph.
 * Darker cells mean more posts; cells with posts link to the month in the archive
 * timeline (id="m{year}-{MM}").
 */
import type { Post } from '../../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const counts = new Map<string, number>();
for (const p of posts) {
  const key = p.dateText.slice(0, 7); // YYYY.MM
  counts.set(key, (counts.get(key) ?? 0) + 1);
}
const postYears = posts.map((p) => Number(p.dateText.slice(0, 4)));
const newest = Math.max(...postYears);
const oldest = Math.min(...postYears);
/** Every year from the newest to the oldest post, including years without posts. */
const years = posts.length ? Array.from({ length: newest - oldest + 1 }, (_, i) => newest - i) : [];
const months = Array.from({ length: 12 }, (_, i) => i + 1);
const level = (n: number) => (n === 0 ? 0 : Math.min(n, 4));
---

<section class="cal" aria-label="每月發文數" hidden={posts.length === 0}>
  <p class="summary">{oldest}–{newest} 共 {posts.length} 篇文章</p>
  <div class="graph">
    <span aria-hidden="true"></span>
    {
      months.map((m) => (
        <span class="month-label" aria-hidden="true">
          {m}月
        </span>
      ))
    }
    {
      years.map((y) => (
        <>
          <span class="year-label">{y}</span>
          {months.map((m) => {
            const n = counts.get(`${y}.${pad(m)}`) ?? 0;
            const label = `${y} 年 ${m} 月 · ${n} 篇`;
            return n > 0 ? (
              <a href={`#m${y}-${pad(m)}`} class={`cell l${level(n)}`} title={label} aria-label={label} />
            ) : (
              <span class="cell" title={label} />
            );
          })}
        </>
      ))
    }
  </div>
  <p class="legend" aria-hidden="true">
    少<span class="cell"></span><span class="cell l1"></span><span class="cell l2"></span><span class="cell l3"></span><span
      class="cell l4"
    ></span>多
  </p>
</section>

<style>
  .cal {
    margin-top: var(--space-6);
  }
  .summary {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-fg-body);
  }
  .graph {
    display: grid;
    grid-template-columns: 2.5rem repeat(12, minmax(0, 1.75rem));
    gap: 4px;
    align-items: center;
  }
  .month-label,
  .year-label {
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-fg-muted);
  }
  .month-label {
    text-align: center;
  }
  .cell {
    display: block;
    aspect-ratio: 1;
    border-radius: 3px;
    background: var(--color-bg-muted);
    outline: 1px solid color-mix(in srgb, var(--color-fg-default) 6%, transparent);
    outline-offset: -1px;
  }
  .l1 {
    background: color-mix(in srgb, var(--color-accent) 30%, var(--color-bg-muted));
  }
  .l2 {
    background: color-mix(in srgb, var(--color-accent) 55%, var(--color-bg-muted));
  }
  .l3 {
    background: color-mix(in srgb, var(--color-accent) 78%, var(--color-bg-muted));
  }
  .l4 {
    background: var(--color-accent);
  }
  a.cell {
    transition: transform var(--duration-fast) var(--ease-standard);
  }
  a.cell:hover,
  a.cell:focus-visible {
    transform: scale(1.2);
  }
  .legend {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: var(--space-3) 0 0;
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
  }
  .legend .cell {
    width: 12px;
  }
  /* Larger cells when there is room. */
  @container center (min-width: 1200px) {
    .graph {
      grid-template-columns: 2.75rem repeat(12, 2.125rem);
    }
  }
</style>

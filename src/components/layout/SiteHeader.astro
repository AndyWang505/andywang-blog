---
/**
 * Sticky glass header. From 1024px it becomes a grid whose segments line up with
 * the rails below (same data-left / data-right contract as the shell).
 * Spec: docs/redesign/02-layout.md §3
 */
import ThemeToggle from '../ThemeToggle';
import Icon from '../ui/Icon.astro';
import SearchButton from './SearchButton.astro';
import ReadingProgress from './ReadingProgress.astro';
import { SITE_TITLE } from '../../config/site';
import type { NavKey, RailLeft, RailRight } from './nav';
import { NAV_ITEMS } from './nav';

interface Props {
  left: RailLeft;
  right: RailRight;
  current?: NavKey;
  progress?: boolean;
}

const { left, right, current, progress = false } = Astro.props;
---

<header class="hdr glass" data-left={left} data-right={right}>
  <div class="hdr-brand">
    <a href="/" class="brand">{SITE_TITLE}</a>
  </div>
  <div class="hdr-nav">
    <a href="/" class="brand brand-inline">{SITE_TITLE}</a>
    <nav class="links" aria-label="主要導覽">
      {
        NAV_ITEMS.map((item) => (
          <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="hdr-acts">
    <SearchButton />
    <ThemeToggle client:load />
    <button
      type="button"
      class="menu-btn"
      aria-label="開啟選單"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="icon-open"><Icon name="menu" size={20} /></span>
      <span class="icon-close"><Icon name="close" size={20} /></span>
    </button>
  </div>
  {progress && <ReadingProgress />}
</header>

<style>
  .hdr {
    --hdr-left: 0px;
    --hdr-right: auto;
    position: relative;
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--space-2) 0 var(--space-4);
    border-bottom: 1px solid var(--color-border-default);
  }
  .brand {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: var(--color-fg-default);
    white-space: nowrap;
  }
  .hdr-brand {
    display: flex;
    align-items: center;
  }
  .hdr-nav,
  .brand-inline {
    display: none;
  }
  .links {
    display: flex;
    gap: var(--space-7);
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }
  .links a {
    transition: color var(--duration-fast);
  }
  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--color-fg-default);
  }
  .links a[aria-current='page'] {
    font-weight: 600;
  }
  .hdr-acts {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
  .menu-btn {
    width: var(--touch-target);
    height: var(--touch-target);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-fg-default);
  }
  .menu-btn:hover {
    background: var(--color-bg-muted);
  }
  .menu-btn .icon-close,
  .menu-btn[aria-expanded='true'] .icon-open {
    display: none;
  }
  .menu-btn[aria-expanded='true'] .icon-close {
    display: inline;
  }

  @media (min-width: 1024px) {
    .hdr {
      display: grid;
      grid-template-columns: var(--hdr-left) minmax(0, 1fr) var(--hdr-right);
      padding: 0;
    }
    .hdr > div {
      height: 100%;
      display: flex;
      align-items: center;
      min-width: 0;
    }
    .hdr-brand {
      grid-column: 1;
      display: none !important;
      padding: 0 var(--space-6);
      border-right: 1px solid var(--color-border-default);
    }
    .hdr-nav {
      grid-column: 2;
      gap: var(--space-10);
      padding: 0 var(--space-8);
    }
    .brand-inline {
      display: inline;
    }
    .hdr-acts {
      grid-column: 3;
      gap: 6px;
      padding: 0 var(--space-3);
    }
    .menu-btn {
      display: none;
    }

    .hdr[data-left='lg'] {
      --hdr-left: var(--rail-left-width);
    }
    .hdr[data-left='lg'] .hdr-brand {
      display: flex !important;
    }
    .hdr[data-left='lg'] .brand-inline {
      display: none;
    }
    .hdr[data-right='toc'] {
      --hdr-right: var(--toc-width);
    }
    .hdr[data-right='toc'] .hdr-acts {
      justify-content: space-between;
      padding: 0 var(--space-3) 0 var(--space-5);
      border-left: 1px solid var(--color-border-default);
    }
  }

  @media (min-width: 1440px) {
    .hdr[data-left='wide'] {
      --hdr-left: var(--rail-left-width);
    }
    .hdr[data-left='wide'] .hdr-brand {
      display: flex !important;
    }
    .hdr[data-left='wide'] .brand-inline {
      display: none;
    }
    .hdr[data-right='rail'] {
      --hdr-right: var(--rail-right-width);
    }
    .hdr[data-right='rail'] .hdr-acts {
      justify-content: space-between;
      padding: 0 var(--space-3) 0 var(--space-5);
      border-left: 1px solid var(--color-border-default);
    }
  }
</style>

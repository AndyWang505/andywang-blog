---
/**
 * Header search: pill (>=1024px) / icon (<1024px) trigger and the glass search dialog (components/Search.tsx).
 */
import Search from '../Search';
import { getSortedPosts } from '../../lib/posts';

const searchData = (await getSortedPosts()).map((post) => ({
  slug: post.slug,
  title: post.title,
  description: post.description,
  category: post.category,
  tags: post.tags,
  pubDate: post.isoDate,
  date: post.dateText, // YYYY.MM.DD in the site time zone
}));
---

<Search client:load posts={searchData} />

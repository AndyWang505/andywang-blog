---
/**
 * Small section heading used in rails and the chapter TOC.
 * Use `as="h2"` for rail section titles so screen readers can jump between them.
 * Optional `after` slot renders on the same line, right-aligned (e.g. "3 / 6").
 * Spec: docs/redesign/03-components.md A1
 */
interface Props {
  text: string;
  as?: 'p' | 'h2' | 'h3';
  class?: string;
}

const { text, as: Tag = 'p', class: className } = Astro.props;
const hasAfter = Astro.slots.has('after');
const labelClass = 'm-0 text-xs font-semibold tracking-[.02em] text-fg-muted';
---

{
  hasAfter ? (
    <div class:list={['mb-2.5 flex items-baseline justify-between gap-3', className]}>
      <Tag class={labelClass}>{text}</Tag>
      <slot name="after" />
    </div>
  ) : (
    <Tag class:list={[labelClass, 'mb-2.5', className]}>{text}</Tag>
  )
}
